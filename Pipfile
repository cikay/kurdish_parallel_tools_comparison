[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Maintained fork of bfsujason/bertalign: LaBSE embeddings, no faiss-gpu,
# offline language detection (lingua), sentence-splitter segmentation.
